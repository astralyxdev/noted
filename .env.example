# noted — configuration. Copy to .env and edit what you need.
# An exported variable always wins over this file.

# ── where things live ────────────────────────────────────────────────────
# Database file. In the container this is /data/tasks.db, a mounted volume.
NOTED_DB=~/.noted/tasks.db
# Built dashboard. Leave empty to serve dashboard/dist next to the code.
# NOTED_UI_DIR=

# ── network ──────────────────────────────────────────────────────────────
# The core listens here. Inside the container it is 0.0.0.0 and the port is
# published only on the host loopback.
NOTED_HOST=127.0.0.1
NOTED_PORT=8787

# Admin token. When set, /api and /mcp require the X-Noted-Token header and
# the dashboard asks for this token once. Leave empty for a local install.
# NOTED_TOKEN=

# Where the stdio adapter looks for the core, and the key it presents.
# NOTED_API=http://127.0.0.1:8787
# NOTED_KEY=

# ── liveness and recovery ────────────────────────────────────────────────
# Lease for claims made outside a session. Inside a session the task is held
# for as long as the session lives, so this does not apply.
NOTED_LEASE_S=300
# How long a session survives without renewal. The transport renews it, so
# short is good: this is how fast a dead process releases its work.
NOTED_SESSION_TTL_S=90
# How often expired leases and dead sessions are collected.
NOTED_REAP_INTERVAL_S=15

# ── retries ──────────────────────────────────────────────────────────────
NOTED_RETRY_BASE_S=5
NOTED_RETRY_CAP_S=300

# ── guard rails ──────────────────────────────────────────────────────────
# Tasks one author may queue per window. Catches a looping agent; 0 disables.
NOTED_CREATE_LIMIT=300
NOTED_CREATE_WINDOW_S=60
# Journal retention for closed tasks, in days. 0 keeps everything.
NOTED_JOURNAL_KEEP_DAYS=30
