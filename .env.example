# noted — configuration. Copy to .env and edit what you need.
# An exported variable always wins over this file.

# ── where things live ────────────────────────────────────────────────────
# Storage engine. Empty means SQLite: one file, nothing to install, the whole
# service in one container. Set a DSN and the same code runs on PostgreSQL
# instead — which is what docker compose does, since a swarm of agents is
# exactly the workload a single writer eventually stops enjoying.
# NOTED_DB_URL=postgresql://noted:noted@postgres:5432/noted
# Connections held against PostgreSQL. Ignored on SQLite.
# NOTED_DB_POOL=10

# SQLite database file. Ignored when NOTED_DB_URL is set.
# In the container this is /data/tasks.db, a mounted volume.
NOTED_DB=~/.noted/tasks.db
# Built dashboard. Leave empty to serve dashboard/dist next to the code.
# NOTED_UI_DIR=

# ── network ──────────────────────────────────────────────────────────────
# The core listens here. Inside the container it is 0.0.0.0 and the port is
# published only on the host loopback.
NOTED_HOST=127.0.0.1
NOTED_PORT=8787

# ── liveness and recovery ────────────────────────────────────────────────
# How long a claimed task is held when the caller asks for no lease. Unless a
# heartbeat renews it the task returns to the queue.
NOTED_LEASE_S=300
# How often expired leases are collected.
NOTED_REAP_INTERVAL_S=15

# ── retries ──────────────────────────────────────────────────────────────
NOTED_RETRY_BASE_S=5
NOTED_RETRY_CAP_S=300

# ── guard rails ──────────────────────────────────────────────────────────
# Tasks one author may queue per window. Catches a looping agent; 0 disables.
NOTED_CREATE_LIMIT=300
NOTED_CREATE_WINDOW_S=60
# Journal retention for closed tasks, in days. 0 keeps everything.
NOTED_JOURNAL_KEEP_DAYS=30
